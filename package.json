{
  "name": "openwitness",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source platform for preserving, organizing, and verifying evidence from public events.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @openwitness/db generate",
    "db:migrate": "pnpm --filter @openwitness/db migrate",
    "db:migrate:deploy": "pnpm --filter @openwitness/db migrate:deploy",
    "db:seed": "pnpm --filter @openwitness/db seed",
    "db:verify": "pnpm --filter @openwitness/db verify",
    "db:studio": "pnpm --filter @openwitness/db studio"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}