# OpenWitness pnpm Configuration
# This file controls pnpm behavior for the monorepo workspace

# Strict dependency management (Requirements 6.2, 6.3, 10.2)
# Fail if peer dependencies are not installed explicitly
strict-peer-dependencies=true

# Require explicit installation of peer dependencies
# Prevents automatic installation that could hide missing dependencies
auto-install-peers=false

# Performance optimization (Requirement 6.4)
# Prevent hoisting all dependencies to root (avoids phantom dependencies)
# Packages can only access their declared dependencies
shamefully-hoist=false

# Use frozen lockfile in CI environments to ensure reproducible builds
prefer-frozen-lockfile=true

# Security (Requirement 6.4)
# Disable pre/post install scripts from untrusted packages
# Scripts must be explicitly enabled per package if needed
enable-pre-post-scripts=false

# Publishing prevention (Requirements 6.5)
# Prevent accidental publishing of workspace packages from root
# Individual packages control their own publishing
publish-workspace-packages=false
