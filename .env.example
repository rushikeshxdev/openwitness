# Neon Postgres (copy to .env and fill in real values — never commit .env)
# DATABASE_URL: pooled connection (-pooler host) for the app
# DIRECT_URL: non-pooled host (no -pooler) for Prisma migrations

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
